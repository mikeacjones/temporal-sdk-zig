.{
    .{ .feature = "build_id_versioning/activity_and_child_on_correct_version", .bead = "temporal-sdk-zig-ck4", .reason = "The 2.0 worker cannot start beside the 1.0 one, as sdk-core refuses a second worker with another legacy build ID on the same client and task queue (temporal-sdk-zig-ck4); after that, workflow.ChildWorkflowOptions has no versioning intent (temporal-sdk-zig-d51.7.14). The feature fails and leaves no history to record." },
    .{ .feature = "build_id_versioning/continues_as_new_on_correct_version", .bead = "temporal-sdk-zig-ck4", .reason = "The 2.0 worker cannot start beside the 1.0 one, as sdk-core refuses a second worker with another legacy build ID on the same client and task queue (temporal-sdk-zig-ck4); after that, workflow.ContinueAsNewOptions has no versioning intent (temporal-sdk-zig-d51.7.14). The feature fails and leaves no history to record." },
    .{ .feature = "serialization_context/async_activity_completion", .bead = "temporal-sdk-zig-d51.4.31", .reason = "Client.completeActivityById gives codecs no workflow or activity type, so the workflow's worker refuses the result it decodes with both." },
    .{ .feature = "serialization_context/external_signal", .bead = "temporal-sdk-zig-d51.4.32", .reason = "A signal to another workflow is encoded with the sender's context, so the receiver refuses it under its own." },
    .{ .feature = "signal/signal_with_start", .bead = "temporal-sdk-zig-d51.7.49", .reason = "A signal buffered when its handler is registered runs only after the workflow function blocks, so the new workflow completes before processing the start-carried signal and the feature fails, leaving no history to record." },
}
