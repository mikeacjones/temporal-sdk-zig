// How samples-test validates this sample: start the worker, run the starter, and check that
// the starter's output contains each `expect` line before `timeout_seconds`.
.{
    .expect = .{
        "Workflow result memo: description=\"Test upsert memo workflow\"",
        "Described memo: description=Test upsert memo workflow",
    },
    .timeout_seconds = 60,
    .tests = .{"memo_workflow_test.zig"},
}
