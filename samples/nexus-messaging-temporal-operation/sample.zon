// How samples-test validates this sample: create the namespaces and the two Nexus endpoints
// below on the dev server, start the worker (all four workers in one process, after it starts
// the caller pattern's greeting workflow for "default-user"), run the starter, and check that
// the starter's output contains each `expect` line before `timeout_seconds`. The caller
// pattern's lines come from messaging that already running workflow; the on-demand pattern's
// from two greeting workflows its caller starts through Nexus (the first by attaching its
// approval context with signal-with-start), messages, and waits for. worker.zig says how to
// set up a server by hand.
.{
    .expect = .{
        "callerpattern [1] getLanguages returned 2 languages",
        "callerpattern [2] setLanguage(Arabic) returned previous language: English",
        "callerpattern [3] getLanguage returned: Arabic (confirmed Arabic)",
        "callerpattern [4] approve sent successfully",
        "ondemandpattern [1] attached approval context before the workflow existed: nexus-messaging-greeting-one",
        "ondemandpattern [2] started remote workflow one: nexus-messaging-greeting-one",
        "ondemandpattern [3] started remote workflow two: nexus-messaging-greeting-two",
        "ondemandpattern [4] attached approval context to the running workflow: nexus-messaging-greeting-two",
        "ondemandpattern [5] getLanguages (one) returned 2 languages",
        "ondemandpattern [6] getLanguages (two) with unsupported returned 7 languages",
        "ondemandpattern [7] setLanguage(French) on one returned previous: English",
        "ondemandpattern [8] setLanguage(Spanish) on two returned previous: English",
        "ondemandpattern [9] getLanguage (one) = French",
        "ondemandpattern [10] getLanguage (two) = Spanish",
        "ondemandpattern [11] approved workflow one",
        "ondemandpattern [12] approved workflow two",
        "ondemandpattern [13] remote workflow one result: Bonjour, monde (approved by CallerRemoteWorkflow)",
        "ondemandpattern [14] remote workflow two result: Hola, mundo (approved by CallerRemoteWorkflow)",
    },
    .timeout_seconds = 60,
    .tests = .{ "callerpattern_test.zig", "ondemandpattern_test.zig" },
    .namespaces = .{ "nexus-messaging-temporal-operation-target-namespace", "nexus-messaging-temporal-operation-caller-namespace" },
    .nexus_endpoints = .{
        .{ .name = "nexus-messaging-temporal-operation-callerpattern-endpoint", .namespace = "nexus-messaging-temporal-operation-target-namespace", .task_queue = "nexus-messaging-temporal-operation-callerpattern-handler" },
        .{ .name = "nexus-messaging-temporal-operation-ondemandpattern-endpoint", .namespace = "nexus-messaging-temporal-operation-target-namespace", .task_queue = "nexus-messaging-temporal-operation-ondemandpattern-handler" },
    },
}
