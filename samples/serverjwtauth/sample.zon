// How samples-test validates this sample: start the worker, run the starter, and check that
// the starter's output contains each `expect` line before `timeout_seconds`. Both run against
// a Temporal server of their own in Docker, with TLS and JWT authorization: the programs read
// its address, CA certificate and server name from the environment, and sign their own tokens
// with the key at SAMPLE_JWT_KEY, whose public half the server trusts. They don't send the
// fixture's TEMPORAL_API_KEY. The key program is built but not run.
.{
    .expect = .{"Workflow result: Hello Temporal!"},
    .timeout_seconds = 120,
    .tests = .{"serverjwtauth_test.zig"},
    .imports = .{"helloworld"},
    .programs = .{"key"},
    .docker_server = .{ .jwt = true },
}
