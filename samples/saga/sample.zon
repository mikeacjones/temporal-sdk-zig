// How samples-test validates this sample: start the worker, run the starter, and check that
// the starter's output contains each `expect` line before `timeout_seconds`. The last step
// fails three times (1+2 seconds of retry backoff) before the compensations run.
.{
    .expect = .{"Transfer failed and was compensated: some error"},
    .timeout_seconds = 60,
    .tests = .{"workflow_test.zig"},
}
