// How samples-test validates this sample: start the worker, run the starter, and check that
// the starter's output contains each `expect` line before `timeout_seconds`. The first cron
// run starts at the next minute boundary, so this can take a minute.
.{
    .expect = .{ "First cron run completed: RunTime=", "Terminated the cron workflow" },
    .timeout_seconds = 120,
}
