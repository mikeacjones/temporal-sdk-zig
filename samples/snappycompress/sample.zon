// How samples-test validates this sample: start the worker, run the starter, and check that
// the starter's output contains each `expect` line before `timeout_seconds`. The starter
// also reads the workflow's input back from history without the codec, to show it stored
// compressed. codec_server is only built, for running by hand with the Temporal CLI.
.{
    .expect = .{
        "Workflow result: Hello My Compressed Friend!",
        "Workflow input as stored: encoding binary/snappy",
        "Workflow input decoded with the codec: My Compressed Friend",
    },
    .timeout_seconds = 60,
    .tests = .{ "snappy_test.zig", "codec_test.zig", "workflow_test.zig" },
    .programs = .{"codec_server"},
}
