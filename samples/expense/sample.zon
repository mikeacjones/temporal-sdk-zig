// How samples-test validates this sample: start the worker, run the starter, and check that
// the starter's output contains each `expect` line before `timeout_seconds`. The starter
// hosts the expense system and approves the expense itself, so the run is unattended.
.{
    .expect = .{
        "Approved expense",
        "Workflow result: COMPLETED",
    },
    .timeout_seconds = 60,
    .tests = .{ "workflow_test.zig", "expense_system_test.zig" },
}
