// How samples-test validates this sample: create the namespaces and the Nexus endpoint below
// on the dev server, start the worker (the handler and caller workers in one process), run
// the starter, and check that the starter's output contains the `expect` line before
// `timeout_seconds`. The greeting comes from the handler's two-argument workflow, which the
// say-hello operation started with the fields of its one input. handler_worker and
// caller_worker run the two workers on their own; worker.zig says how to set up a server by
// hand.
.{
    .expect = .{"Workflow result: ¡Hola! Nexus 👋"},
    .timeout_seconds = 60,
    .tests = .{ "caller_test.zig", "handler_test.zig" },
    .programs = .{ "handler_worker", "caller_worker" },
    .namespaces = .{ "my-multiple-arguments-target-namespace", "my-multiple-arguments-caller-namespace" },
    .nexus_endpoints = .{
        .{ .name = "nexus-multiple-arguments-endpoint", .namespace = "my-multiple-arguments-target-namespace", .task_queue = "nexus-multiple-arguments-handler" },
    },
}
