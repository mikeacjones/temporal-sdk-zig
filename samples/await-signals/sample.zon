// How samples-test validates this sample: start the worker, run the starter, and check that
// the starter's output contains each `expect` line before `timeout_seconds`. The starter sends
// the signals in a random order, so the lines are checked in any order.
.{
    .expect = .{
        "Sent Signal1",
        "Sent Signal2",
        "Sent Signal3",
        "Workflow completed",
    },
    .timeout_seconds = 60,
    .tests = .{"await_signals_workflow_test.zig"},
}
