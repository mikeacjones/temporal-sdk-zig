// How samples-test validates this sample: start the worker, run the starter, and check that
// the starter's output contains each `expect` line before `timeout_seconds`. The workflow
// never finishes on its own, so the starter terminates it after its requests.
.{
    .expect = .{
        "Result: \"FOO0\"",
        "Result: \"FOO1\"",
        "Result: \"FOO2\"",
        "Result: \"FOO3\"",
        "Result: \"FOO4\"",
        "Terminated the reqrespupdate workflow",
    },
    .timeout_seconds = 60,
}
