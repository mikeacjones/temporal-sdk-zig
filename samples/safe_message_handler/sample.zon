// How samples-test validates this sample: start the worker, run the starter, and check that
// the starter's output contains each `expect` line before `timeout_seconds`.
.{
    .expect = .{"Cluster shut down successfully: num_currently_assigned_nodes=20 num_bad_nodes=5"},
    .timeout_seconds = 60,
    .tests = .{"workflow_test.zig"},
}
