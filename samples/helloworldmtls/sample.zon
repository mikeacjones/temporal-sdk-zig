// How samples-test validates this sample: start the worker, run the starter, and check that
// the starter's output contains each `expect` line before `timeout_seconds`. Both run against
// a Temporal server of their own in Docker, with TLS that requires a client certificate: the
// programs read its address, CA certificate and server name, and the paths of a client
// certificate and key the server trusts, from the environment.
.{
    .expect = .{"Workflow result: Hello Temporal!"},
    .timeout_seconds = 120,
    .tests = .{"helloworld_test.zig"},
    .docker_server = .{ .require_client_cert = true },
}
